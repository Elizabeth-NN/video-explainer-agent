def _multi_concept_physics_script(
    topic: str,
    evidence: list[str],
    required_concepts: list[dict],
) -> str | None:
    """Build a concise, ordered physics lesson from relevant evidence."""
    sections = (
        (
            "Newton's second law",
            ("net force", "mass", "acceleration", "second law"),
            "Forces come first.",
        ),
        (
            "Kinematics",
            ("kinematics", "position", "displacement", "velocity", "motion"),
            "Next, describe motion.",
        ),
        (
            "Free fall",
            ("free fall", "gravity", "acceleration", "air resistance"),
            "In free fall, gravity acts alone.",
        ),
        (
            "Projectile motion",
            (
                "projectile motion", "trajectory", "launch angle",
                "horizontal", "vertical", "initial velocity", "parabolic",
            ),
            "For launches, separate horizontal and vertical motion.",
        ),
        (
            "Gravitational potential energy",
            (
                "gravitational potential energy", "potential energy",
                "mgh", "mass", "height", "gravity", "stored energy",
            ),
            "Finally, consider gravitational potential energy.",
        ),
    )

    requested = {
        str(item.get("concept", "")).casefold()
        for item in required_concepts
        if isinstance(item, dict)
    }
    topic_lower = topic.casefold()
    topic_aliases = {
        "newton's second law": ("newton's second law", "newton second law"),
        "kinematics": ("kinematics",),
        "free fall": ("free fall",),
        "projectile motion": ("projectile motion",),
        "gravitational potential energy": (
            "gravitational potential energy", "potential energy",
        ),
    }

    if not all(
        name.casefold() in requested
        or any(alias in topic_lower for alias in topic_aliases[name.casefold()])
        for name, _, _ in sections
    ):
        return None

    selected = []
    used = set()

    for name, markers, _ in sections:
        candidates = []

        for sentence in evidence:
            normalized = sentence.casefold()
            count = len(sentence.split())

            if normalized in used or not 4 <= count <= 40:
                continue

            score = sum(marker in normalized for marker in markers)

            # Prefer the direct definition, not merely related vocabulary.
            if name == "Newton's second law":
                if "net force" in normalized:
                    score += 3
            elif name == "Kinematics":
                if "in physics" in normalized:
                    score += 2
                if any(term in normalized for term in (
                    "in geometry", "angular measure", "kinematic chain",
                    "end-effector", "robot manipulator",
                )):
                    score -= 5
            elif name == "Free fall":
                if "free fall" in normalized:
                    score += 2
            elif name == "Projectile motion":
                if "projectile motion" in normalized:
                    score += 2
                if "trajectory" in normalized:
                    score += 2
                if "horizontal" in normalized and "vertical" in normalized:
                    score += 1
            elif name == "Gravitational potential energy":
                if "gravitational potential energy" in normalized:
                    score += 3
                elif "potential energy" in normalized:
                    score += 2
                # Prefer an equation when the retrieved evidence contains it.
                if "mgh" in normalized:
                    score += 6

            if score > 0:
                candidates.append((score, -count, sentence))

        if not candidates:
            return None

        _, _, sentence = max(candidates, key=lambda item: (item[0], item[1]))

        # Prefer explaining the variables alongside the equation when both
        # are present in the retrieved evidence. Never invent the equation.
        if name == "Gravitational potential energy":
            if "mgh" in sentence.casefold():
                supporting_sentence = next(
                    (
                        item for item in evidence
                        if item.casefold() not in used
                        and item.casefold() != sentence.casefold()
                        and "mass" in item.casefold()
                        and "height" in item.casefold()
                        and any(
                            term in item.casefold()
                            for term in ("gravity", "gravitational")
                        )
                    ),
                    None,
                )
                if supporting_sentence:
                    used.add(supporting_sentence.casefold())
                    sentence = f"{supporting_sentence} {sentence}"
            else:
                formula_sentence = next(
                    (
                        item for item in evidence
                        if item.casefold() not in used
                        and item.casefold() != sentence.casefold()
                        and "mgh" in item.casefold()
                    ),
                    None,
                )
                if formula_sentence:
                    used.add(formula_sentence.casefold())
                    sentence = f"{sentence} {formula_sentence}"

        used.add(sentence.casefold())
        selected.append(sentence)

    parts = [
        "Imagine five connected ideas that explain forces, motion, and energy."
    ]

    for (_, _, introduction), sentence in zip(sections, selected):
        parts.extend((introduction, sentence))

    parts.append("Together, these ideas connect forces, motion, and energy.")

    script = re.sub(r"\s+", " ", " ".join(parts)).strip()

    if not 80 <= len(script.split()) <= 180:
        return None

    return script

def scriptwriter_node(state: VideoState) -> dict:
    """Create a deterministic, evidence-grounded fallback script."""
    topic = state["topic"].strip()
    if not topic:
        raise ValueError("A topic is required to write the script.")

    sources = state.get("research_sources", [])
    if not sources:
        raise RuntimeError(
            "No research sources are available for the fallback writer."
        )

    def sentences_from(source: dict) -> list[str]:
        summary = clean_research_text(source.get("summary", ""))
        sentences = re.split(r"(?<=[.!?])\s+", summary)

        return [
            sentence.strip()
            for sentence in sentences
            if len(sentence.split()) >= 4
        ]

    evidence = []
    seen = set()

    for source in sources:
        for sentence in sentences_from(source):
            normalized = sentence.casefold()
            if normalized not in seen:
                seen.add(normalized)
                evidence.append(sentence)

    if not evidence:
        raise RuntimeError(
            "The available research sources contain no usable summaries."
        )

    physics_script = _multi_concept_physics_script(
        topic,
        evidence,
        state.get("required_concepts") or [],
    )
    if physics_script:
        return {"script": physics_script}

    topic_label = re.sub(
        r"^(how does|how do|how is|how are|how can|what is|what are)\s+",
        "",
        topic.rstrip(".!?").strip(),
        flags=re.IGNORECASE,
    )
    topic_label = re.sub(
        r"\s+work(s)?$",
        "",
        topic_label,
        flags=re.IGNORECASE,
    ).strip()

    parts = [
        f"Imagine exploring {topic_label} and discovering how it works.",
        (
            f"The key is to understand the evidence behind {topic_label}. "
            "Start with the main process and the details that explain it."
        ),
    ]

    closing = (
        "These details connect the main ideas and show how the process "
        "works, while keeping the explanation grounded in the available "
        "evidence."
    )

    # Reserve room for the closing before adding evidence.
    for sentence in evidence:
        candidate = " ".join(parts + [sentence, closing])
        if len(candidate.split()) <= 180:
            parts.append(sentence)

    padding = (
        "Following each step carefully helps connect the evidence "
        "to the central idea and makes the explanation easier to follow."
    )

    # Add neutral narration only if the evidence is too short.
    while len(" ".join(parts + [closing]).split()) < 80:
        candidate = " ".join(parts + [padding, closing])

        if len(candidate.split()) > 180:
            break

        parts.append(padding)

    script = re.sub(
        r"\s+", " ", " ".join(parts + [closing])
    ).strip()

    word_count = len(script.split())
    if not 80 <= word_count <= 180:
        raise RuntimeError(
            "The fallback writer could not produce a script between "
            f"80 and 180 words; it produced {word_count}."
        )

    return {"script": script}
def gemini_scriptwriter_node(state: VideoState) -> dict:
    """Generate a script grounded in the retrieved research.

    This is the general writing path. It works for any topic by
    following the supplied evidence, key questions, and required
    concepts rather than topic-specific templates.
    """
    api_key = os.getenv("GEMINI_API_KEY")
    model = os.getenv("GEMINI_MODEL", "gemini-3.1-flash-lite")

    if not api_key or not api_key.strip():
        raise RuntimeError(
            "GEMINI_API_KEY is missing. Add it to backend/.env."
        )

    from google import genai
    from google.genai import types

    sources = state.get("research_sources", [])
    evidence = "\n\n".join(
        f"Source: {source['title']}\n"
        f"URL: {source['url']}\n"
        f"Summary: {source['summary']}"
        for source in sources
    )

    if not evidence:
        raise RuntimeError(
            "No research sources are available. "
            "Run the research node before generating a script."
        )

    system_instruction = """
You are an explainer-video scriptwriter.

Write an engaging, clear script for a general audience.
Start with a curiosity-driven hook beginning with "Imagine".
Aim for approximately 100-150 words.
Use simple language and a logical sequence that follows the evidence.
Use only factual claims reasonably supported by the supplied sources.
Do not invent statistics, quotations, sources, or citations.
The supplied sources may contain errors; do not claim they independently
verify every fact.
If evidence is insufficient, avoid unsupported details rather than
filling gaps from memory.
Check the final script for missing spaces between words, accidental
joined words, duplicated words, and awkward sentence boundaries.
Use normal punctuation and a space between every separate word.
Before returning, reread the complete script for formatting errors.
For evidence screening, write each factual sentence using key terms and
relationships explicitly present in at least one supplied source summary.
Prefer clear, close paraphrases over broad analogies or decorative claims.
Do not present an analogy as a factual claim about the topic.
When critic feedback identifies limited word overlap, rewrite the flagged
sentence using supported source wording or remove it; do not merely swap
synonyms or repeat the same claim in different words.
Avoid concluding restatements that introduce new claims.
When revising, address each critic issue without inventing evidence.
Return JSON with two fields: "script" (the script text only, with no
title or commentary) and "sources_used" (the titles of the supplied
sources the script relies on).
""".strip()

    key_questions = state.get("key_questions") or []
    required_concepts = state.get("required_concepts") or []
    critique = (state.get("critique") or "").strip()
    previous_script = (state.get("script") or "").strip()

    planning_context = ""
    if key_questions:
        planning_context += (
            "Questions the script should answer where the sources "
            "support an answer:\n"
            + "\n".join(f"- {question}" for question in key_questions)
            + "\n\n"
        )
    if required_concepts:
        planning_context += (
            "Concepts the script should explain where the sources "
            "support them:\n"
            + "\n".join(
                f"- {item['concept']} "
                f"(related terms: {', '.join(item['keywords'])})"
                for item in required_concepts
            )
            + "\n\n"
        )

    if critique and previous_script:
        revision_instructions = (
            "Revise the previous script below to address the critic "
            "feedback. Keep supported claims and change only what the "
            "feedback requires.\n\n"
            f"Previous script:\n{previous_script}\n\n"
            f"Critic feedback:\n{critique}\n\n"
            "For each sentence flagged for limited word overlap, either "
            "rewrite it using wording and concepts traceable to one "
            "supplied source summary, or remove it. Do not preserve a "
            "flagged analogy by merely changing its wording. Keep the "
            "opening beginning with Imagine, but make the hook itself "
            "evidence-aligned. Do not add unsupported replacement claims."
            "\n\n"
        )
    elif critique:
        revision_instructions = (
            f"Address this critic feedback:\n{critique}\n\n"
        )
    else:
        revision_instructions = ""

    prompt = (
        f"Topic: {state['topic']}\n\n"
        f"{planning_context}"
        f"Research from Wikipedia:\n{evidence}\n\n"
        f"{revision_instructions}"
        "Write the explainer-video script using this evidence, following "
        "all script requirements."
    )

    try:
        client = genai.Client(api_key=api_key)
        response = client.models.generate_content(
            model=model,
            contents=prompt,
            config=types.GenerateContentConfig(
                system_instruction=system_instruction,
                response_mime_type="application/json",
                temperature=0.4,
                max_output_tokens=1200,
            ),
        )
    except Exception as exc:
        raise RuntimeError(
            "Gemini script generation failed. Check your API key, "
            "model availability, internet connection, and API quota. "
            f"Details: {exc}"
        ) from exc

    raw_text = (response.text or "").strip()
    script = ""
    sources_used: list[str] = []

    try:
        data = json.loads(raw_text)
        if isinstance(data, dict):
            script_value = data.get("script")
            if isinstance(script_value, str):
                script = script_value.strip()
            sources_used = _clean_str_list(data.get("sources_used"), 10)
    except ValueError:
        # Fall back to treating the response as plain script text.
        script = raw_text

    if not script:
        raise RuntimeError(
            "Gemini returned an empty script. Try the request again."
        )

    # Keep only citations that match supplied sources.
    known_titles = {source["title"].casefold(): source["title"] for source in sources}
    script_sources = [
        known_titles[title.casefold()]
        for title in sources_used
        if title.casefold() in known_titles
    ]

    return {
        "script": clean_research_text(script),
        "script_sources": script_sources,
    }


def grounded_scriptwriter_node(state: VideoState) -> dict:
    """General writer: Gemini first, deterministic fallback if it fails.

    Use this as the workflow's writer (and as the `writer` passed to
    revise_script_node) so a missing key or API error does not stop the
    workflow.
    """
    try:
        return gemini_scriptwriter_node(state)
    except RuntimeError as exc:
        print(f"Gemini writer unavailable, using fallback writer: {exc}")
        return scriptwriter_node(state)


