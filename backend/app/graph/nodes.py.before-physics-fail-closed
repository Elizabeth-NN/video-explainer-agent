def search_wikipedia(query: str, limit: int = 10) -> list[dict]:
    """Search Wikipedia and return raw search results."""
    response = requests.get(
        WIKIPEDIA_API,
        params={
            "action": "query",
            "list": "search",
            "srsearch": query,
            "srlimit": limit,
            "format": "json",
        },
        headers={"User-Agent": USER_AGENT},
        timeout=15,
    )
    response.raise_for_status()
    return response.json()["query"]["search"]


def fetch_candidate(
    title: str,
    *,
    full_extract: bool = False,
) -> dict | None:
    """Fetch an article summary, optionally enriching it with a longer extract."""
    slug = quote(title.replace(" ", "_"), safe="()_")
    page_url = "https://en.wikipedia.org/wiki/" + slug

    try:
        response = requests.get(
            "https://en.wikipedia.org/api/rest_v1/page/summary/" + slug,
            headers={"User-Agent": USER_AGENT},
            timeout=15,
        )
        response.raise_for_status()
        page = response.json()
    except (requests.RequestException, ValueError):
        # Skip unavailable or malformed article responses.
        return None

    if not isinstance(page, dict):
        return None

    extract = page.get("extract", "")
    if not isinstance(extract, str):
        return None

    summary = clean_research_text(extract)
    if not summary:
        return None

    # Physics explainers need enough detail to connect several concepts.
    # Keep the REST summary as a fallback if the longer extract is unavailable.
    if full_extract:
        try:
            extract_response = requests.get(
                WIKIPEDIA_API,
                params={
                    "action": "query",
                    "prop": "extracts",
                    "explaintext": 1,
                    "exchars": 6000,
                    "redirects": 1,
                    "titles": title,
                    "format": "json",
                },
                headers={"User-Agent": USER_AGENT},
                timeout=15,
            )
            extract_response.raise_for_status()
            extract_data = extract_response.json()
            pages = extract_data.get("query", {}).get("pages", {})
            if isinstance(pages, dict):
                for article in pages.values():
                    if not isinstance(article, dict):
                        continue
                    longer_extract = article.get("extract", "")
                    if isinstance(longer_extract, str):
                        cleaned_extract = clean_research_text(longer_extract)
                        if len(cleaned_extract) > len(summary):
                            summary = cleaned_extract
                    break
        except (requests.RequestException, ValueError, AttributeError):
            pass

    content_urls = page.get("content_urls", {})
    desktop = (
        content_urls.get("desktop", {})
        if isinstance(content_urls, dict)
        else {}
    )
    candidate_url = desktop.get("page") if isinstance(desktop, dict) else None

    # Fall back to the title-derived Wikipedia URL if needed.
    url = candidate_url if normalize_source_url(candidate_url) else page_url

    if normalize_source_url(url) is None:
        return None

    return {"title": title, "url": url, "summary": summary}


def evaluate_sources(
    topic: str,
    candidates: list[dict],
    key_questions: list[str],
) -> tuple[list[dict], set[int] | None]:
    """Select relevant sources and report which key questions they cover.

    Gemini's semantic judgment is preferred. If it is unavailable, fall
    back to the keyword baseline; coverage is then unknown (None).
    """
    deduped = deduplicate_valid_sources(candidates)[:MAX_JUDGED_CANDIDATES]

    judged = gemini_relevance_filter(topic, deduped, key_questions)
    if judged is not None:
        selected, covered = judged

        # Apply the same final relevance gate to Gemini-selected sources.
        filtered = [
            item
            for item in selected
            if is_relevant_source(
                topic,
                item.get("title", ""),
                item.get("summary", ""),
            )
        ]

        # If filtering removed sources, Gemini's previous coverage assessment
        # may no longer describe the retained evidence.
        if len(filtered) != len(selected):
            covered = None

        # Recover relevant candidates if Gemini selected only rejected items.
        if not filtered:
            filtered = [
                item
                for item in deduped
                if is_relevant_source(
                    topic,
                    item.get("title", ""),
                    item.get("summary", ""),
                )
            ]

        # Supplement Gemini's selections for multi-concept physics topics.
        physics_plan = _physics_fallback_plan(topic)
        if physics_plan is not None and filtered:
            existing = {
                (item.get("url", ""), item.get("title", "").casefold())
                for item in filtered
            }
            supplemental = [
                item
                for item in deduped
                if (
                    item.get("url", ""),
                    item.get("title", "").casefold(),
                ) not in existing
                and is_relevant_source(
                    topic,
                    item.get("title", ""),
                    item.get("summary", ""),
                )
            ]

            if supplemental:
                filtered.extend(supplemental)
                # Gemini's original coverage assessment is now stale.
                covered = None

        return deduplicate_valid_sources(filtered), covered

    baseline = [
        item
        for item in deduped
        if is_relevant_source(topic, item["title"], item["summary"])
    ]
    return deduplicate_valid_sources(baseline), None


def research_node(state: VideoState) -> dict:
    """Retrieve relevant Wikipedia summaries using planned, iterative search."""
    topic = state["topic"].strip()

    if not topic:
        raise ValueError("The research topic cannot be empty.")

    try:
        plan = plan_research(topic)
        key_questions = plan["key_questions"]
        queries = expand_research_queries(topic, plan["search_queries"])

        candidates: list[dict] = []
        seen_titles: set[str] = set()
        use_full_extract = _physics_fallback_plan(topic) is not None

        def add_candidates(search_results: list[dict]) -> None:
            """Fetch summaries, skipping malformed or repeated results."""
            for result in search_results:
                if not isinstance(result, dict):
                    continue

                title = result.get("title")
                if not isinstance(title, str) or not title.strip():
                    continue

                title = title.strip()
                title_key = " ".join(title.casefold().split())

                # Avoid refetching the same article across searches.
                if not title_key or title_key in seen_titles:
                    continue
                seen_titles.add(title_key)

                candidate = fetch_candidate(
                    title,
                    full_extract=use_full_extract,
                )
                if candidate is not None:
                    candidates.append(candidate)

        def run_searches(search_queries: list[str], limit: int) -> None:
            for query in search_queries:
                try:
                    add_candidates(search_wikipedia(query, limit))
                except (requests.RequestException, KeyError, ValueError):
                    continue

        # Search the user's original topic first. A failure here should
        # still surface as a research error.
        initial_results = search_wikipedia(queries[0], INITIAL_SEARCH_LIMIT)

        if not initial_results:
            print(f"No direct Wikipedia results for: {topic}")

        # Add planned results first so concept-specific evidence is not
        # crowded out by broad-topic results when candidates are capped.
        run_searches(
            queries[1:MAX_PLANNED_QUERIES + 1],
            RELATED_SEARCH_LIMIT,
        )

        # Preserve broad-topic results as supplementary evidence.
        add_candidates(initial_results)

        sources, covered = evaluate_sources(topic, candidates, key_questions)

        # Evidence-driven follow-up: search for key questions that the
        # current sources do not appear to answer, then re-evaluate once.
        if covered is not None and key_questions:
            missing = [
                question
                for index, question in enumerate(key_questions)
                if index not in covered
            ]
            if missing:
                before = len(candidates)
                run_searches(missing[:MAX_GAP_QUERIES], RELATED_SEARCH_LIMIT)

                if len(candidates) > before:
                    sources, covered = evaluate_sources(
                        topic, candidates, key_questions
                    )

        if not candidates:
            raise RuntimeError(
                "Wikipedia search returned no usable article summaries. "
                "Check your connection and try again."
            )

        if not sources:
            raise RuntimeError(
                "No sufficiently relevant research sources were found. "
                "Try a more specific topic or check the research results."
            )

        research_notes = [
            f"{item['title']}: {item['summary']}"
            for item in sources
        ]

        return {
            "research_notes": research_notes,
            "research_sources": sources,
            "research_quality": classify_research_quality(
                len(sources),
                len(key_questions),
                len(covered) if covered is not None else None,
            ),
            "key_questions": key_questions,
            "required_concepts": plan["required_concepts"],
        }

    except requests.RequestException as exc:
        raise RuntimeError(
            "Research failed while contacting Wikipedia. "
            "Check your internet connection and try again."
        ) from exc

def tavily_research_node(state: VideoState) -> dict:
    """Attempt one bounded Tavily search to fill a research evidence gap."""
    if state.get("tavily_used", False):
        return {"tavily_used": True}

    # Mark the attempt before any operation so later graph routes cannot
    # repeat the search if Tavily fails or its key is unavailable.
    result = {"tavily_used": True}
    api_key = os.getenv("TAVILY_API_KEY")

    if not api_key:
        result["critique"] = (
            f"{state.get('critique', '')} "
            "Tavily fallback was unavailable because TAVILY_API_KEY "
            "is not configured."
        ).strip()
        return result

    topic = state.get("topic", "").strip()
    gaps = state.get("research_gaps") or []

    # Keep the query short. Do not submit the entire script.
    query = topic
    if gaps:
        first_gap = " ".join(str(gaps[0]).split())[:160]
        if first_gap:
            query = f"{topic} {first_gap}"

    try:
        response = requests.post(
            "https://api.tavily.com/search",
            json={
                "api_key": api_key,
                "query": query,
                "search_depth": "basic",
                "max_results": 5,
                "include_answer": False,
            },
            timeout=15,
        )
        response.raise_for_status()
        payload = response.json()

        if not isinstance(payload, dict):
            raise ValueError("Unexpected Tavily response format.")

        results = payload.get("results", [])
        if not isinstance(results, list):
            results = []

        tavily_sources = []
        for item in results:
            if not isinstance(item, dict):
                continue

            title = item.get("title")
            url = item.get("url")
            summary = item.get("content") or item.get("raw_content")

            if not all(
                isinstance(value, str) and value.strip()
                for value in (title, url, summary)
            ):
                continue

            if not is_relevant_source(topic, title, summary):
                continue

            tavily_sources.append({
                "title": title.strip(),
                "url": url.strip(),
                "summary": clean_research_text(summary),
            })

        # Preserve Wikipedia sources and remove duplicate or malformed
        # results using the existing source validation helper.
        combined = deduplicate_valid_sources([
            *state.get("research_sources", []),
            *tavily_sources,
        ])

        if not combined:
            result["critique"] = (
                f"{state.get('critique', '')} "
                "Tavily did not provide any additional usable research "
                "sources."
            ).strip()
            return result

        result.update({
            "research_sources": combined,
            "research_notes": [
                f"{source['title']}: {source['summary']}"
                for source in combined
            ],
            "research_quality": classify_research_quality(len(combined)),
        })

        return result

    except (requests.RequestException, ValueError, TypeError) as exc:
        # A failed fallback should not crash the workflow. Keep the
        # existing evidence and allow the graph to decide what happens next.
        result["critique"] = (
            f"{state.get('critique', '')} "
            f"Tavily fallback failed ({type(exc).__name__}); "
            "the existing research was retained."
        ).strip()
        return result

