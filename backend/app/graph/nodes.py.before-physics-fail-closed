def critic_node(state: VideoState) -> dict:
    """Check structure, topic coverage, concept coverage, and evidence overlap."""
    script = state["script"].strip()
    topic = state["topic"].strip()
    words = script.split()
    issues = []
    critic_categories = []
    research_gaps = []

    if not script.startswith("Imagine"):
        issues.append(
            "Start with a curiosity-driven hook beginning with 'Imagine'."
        )
        critic_categories.append("structure")

    if not 80 <= len(words) <= 180:
        issues.append(
            f"The script must contain 80-180 words; it currently has "
            f"{len(words)}."
        )
        critic_categories.append("structure")

    sources = state.get("research_sources", [])
    research_quality = state.get("research_quality", "unknown")
    research_warning = ""

    if research_quality == "insufficient":
        issues.append(
            "Research coverage is insufficient: fewer than two relevant "
            "sources are available. Additional research is required "
            "before this script can be approved."
        )
        critic_categories.append("research_gap")
        research_gaps.append(
            "Research coverage is insufficient: fewer than two relevant "
            "sources are available."
        )
    elif research_quality == "limited":
        research_warning = (
            "Research coverage is limited; verify key claims against "
            "the full sources before publication."
        )

    if not sources:
        issues.append(
            "At least one research source is required before approval."
        )
        if "research_gap" not in critic_categories:
            critic_categories.append("research_gap")
        research_gaps.append(
            "No research sources are available to support the script."
        )

    if len(words) < 10:
        issues.append(
            "The script needs enough meaningful content to explain the topic."
        )
        if "structure" not in critic_categories:
            critic_categories.append("structure")

    lower_script = script.lower()
    disclaimer_phrases = (
        "the source summary identifies",
        "we should distinguish what the sources state",
        "together, these sources provide a starting point",
        "research summaries help guide the explanation",
        "not proof that every detail has been independently verified",
    )
    if any(phrase in lower_script for phrase in disclaimer_phrases):
        issues.append(
            "Replace research disclaimers with a substantive explanation "
            "of the topic."
        )
        critic_categories.append("style")

    stopwords = {
        "about", "after", "again", "also", "and", "are", "because",
        "before", "being", "between", "but", "can", "could", "does",
        "each", "for", "from", "have", "into", "its", "just", "like",
        "more", "most", "not", "often", "only", "other", "over", "some",
        "such", "than", "that", "the", "their", "them", "then", "there",
        "these", "they", "this", "those", "through", "under", "using",
        "very", "was", "were", "what", "when", "where", "which", "while",
        "with", "would", "your", "you", "how", "why", "who", "will",
        "our", "out", "all", "any", "has", "had", "his", "her",
        "she", "him", "been", "it", "is", "in",
        "on", "of", "to", "as", "at", "by", "a", "an", "i", "we",
        "he", "or", "if", "do", "did", "up", "so", "now",
        "imagine", "explanation", "explains", "explain",
    }

    def content_terms(text: str) -> set[str]:
        terms = set()
        for word in re.findall(r"[a-zA-Z]{3,}", text.lower()):
            if word in stopwords:
                continue
            # Normalize common plurals for simple word matching.
            if len(word) > 4 and word.endswith("s"):
                word = word[:-1]
            terms.add(word)
        return terms

    topic_terms = content_terms(topic)
    script_terms = content_terms(script)

    if topic_terms and not (topic_terms & script_terms):
        issues.append(
            "The script does not clearly cover the requested topic."
        )
        critic_categories.append("topic_coverage")

    # Per-video learning objectives come from the research plan, not from
    # topic-specific branches. A concept counts as covered when any of its
    # keywords appears in the script.
    required_concepts = state.get("required_concepts") or []
    if required_concepts:
        missing_concepts = [
            item["concept"]
            for item in required_concepts
            if not any(
                keyword in lower_script
                for keyword in item["keywords"]
            )
        ]
        covered_count = len(required_concepts) - len(missing_concepts)
        needed = math.ceil(len(required_concepts) * MIN_CONCEPT_COVERAGE)

        if covered_count < needed:
            issues.append(
                "The script does not yet explain these planned concepts: "
                + "; ".join(missing_concepts)
                + ". Cover them only where the sources support them."
            )
            critic_categories.append("concept_coverage")

            # Record concept gaps separately. They may need better writing,
            # more research, or both; they do not automatically prove that
            # additional web research is necessary.
            research_gaps.extend(
                f"Planned concept needs coverage: {concept}"
                for concept in missing_concepts
            )

    sentences = [
        sentence.strip()
        for sentence in re.split(r"(?<=[.!?])\s+", script)
        if sentence.strip()
    ]
    unsupported = []
    weak_claims = []
    supported_count = 0

    # These are generic narration transitions, not standalone factual claims.
    non_claim_prefixes = (
        "together, these details help explain",
        "to understand the process,",
        "consider what starts the process,",
        "these connections help turn",
        "the retrieved summaries provide a starting point",
        "the full sources should be consulted",
        "read together, these details show how the retrieved evidence relates to",
        "the key is to understand the evidence behind",
        "start with the main process and the details that explain it",
        "these details connect the main ideas and show how the process works",
        "following each step carefully helps connect the evidence to the central idea",
    )

    # Compare each claim with each source separately. This prevents
    # unrelated terms spread across sources from inflating support.
    if sources:
        for sentence in sentences:
            sentence_words = sentence.split()
            sentence_terms = content_terms(sentence)

            if sentence.lower().startswith(non_claim_prefixes):
                continue

            # Short hooks and transitions are difficult to assess reliably.
            if len(sentence_words) < 8 or len(sentence_terms) < 3:
                continue

            best_overlap = 0
            best_ratio = 0.0

            for source in sources:
                source_terms_for_claim = content_terms(
                    f"{source.get('title', '')} "
                    f"{source.get('summary', '')}"
                )
                overlap = sentence_terms & source_terms_for_claim
                ratio = len(overlap) / len(sentence_terms)

                if (ratio, len(overlap)) > (best_ratio, best_overlap):
                    best_ratio = ratio
                    best_overlap = len(overlap)

            if best_overlap >= 2 and best_ratio >= 0.35:
                supported_count += 1
            elif best_overlap >= 2 and best_ratio >= 0.15:
                weak_claims.append(sentence)
            else:
                unsupported.append(sentence)

    evidence_warning = ""
    if weak_claims:
        examples = " ".join(weak_claims[:2])
        evidence_warning = (
            f"Evidence review required: {len(weak_claims)} substantive "
            "sentence(s) have weak source matches. This may reflect "
            "paraphrasing or missing evidence; it is not proof the claims "
            f"are false. Example: {examples}"
        )

    if unsupported:
        critic_categories.append("unsupported_claims")
        research_gaps.extend(unsupported[:5])

        examples = " ".join(unsupported[:2])
        issues.append(
            f"{len(unsupported)} substantive sentence(s) have limited "
            "word overlap with any individual source. Their evidence "
            "could not be matched reliably; revise or verify them before "
            f"approval. Example: {examples}"
        )

    # Keep category names unique while preserving their original order.
    critic_categories = list(dict.fromkeys(critic_categories))

    # Remove duplicate gap messages without changing their order.
    research_gaps = list(dict.fromkeys(research_gaps))

    if issues:
        critique = " ".join(issues)
        if research_warning:
            critique = f"{critique} {research_warning}"
        if evidence_warning:
            critique = f"{critique} {evidence_warning}"

        return {
            "critique": critique,
            "approved": False,
            "critic_categories": critic_categories,
            "research_gaps": research_gaps,
        }

    critique = (
        f"Structural and evidence-overlap checks passed: opening hook, "
        f"{len(words)} words, topic coverage, and research sources "
        "present. Text overlap is only a screening signal; factual "
        "accuracy has not been independently verified."
    )
    critique += (
        f" Evidence screening: {supported_count} supported match(es), "
        f"{len(weak_claims)} weak match(es), "
        f"{len(unsupported)} unsupported match(es)."
    )
    if evidence_warning:
        critique = f"{critique} {evidence_warning}"
    if research_warning:
        critique = f"{critique} {research_warning}"

    return {
        "critique": critique,
        "approved": True,
        "critic_categories": critic_categories,
        "research_gaps": research_gaps,
    }

def gemini_critic_node(state: VideoState) -> dict:
    """Add an evidence-focused Gemini review to the deterministic critic.

    Gemini compares the script with supplied research summaries. It does
    not independently verify the truth of those summaries.
    """
    baseline = critic_node(state)

    # Preserve deterministic rejection for structural or evidence-overlap
    # failures. Gemini is an additional check, not a replacement.
    if not baseline.get("approved", False):
        return baseline

    sources = state.get("research_sources", [])
    script = (state.get("script") or "").strip()

    if not sources or not script:
        return {
            **baseline,
            "critique": (
                f"{baseline.get('critique', '')} "
                "Gemini evidence review skipped: script or sources missing."
            ).strip(),
        }

    evidence = [
        {
            "title": source.get("title", ""),
            "summary": source.get("summary", ""),
        }
        for source in sources
    ]

    prompt = f"""
Review the factual claims in this explainer script against the supplied
research summaries.

Topic: {state.get("topic", "")}

Research summaries:
{json.dumps(evidence, ensure_ascii=False)}

Script:
{script}

Rules:
- Use only the supplied summaries as evidence.
- Do not use outside knowledge to fill evidence gaps.
- Distinguish a reasonable paraphrase from a claim that adds unsupported
  details, causes, numbers, certainty, or relationships.
- Do not reject a claim merely because it uses different wording.
- Ignore clearly non-factual transitions and imaginative wording that
  is not presented as a factual statement.
- If a claim cannot be supported by these summaries, identify it and
  explain what evidence is missing.
- A supported verdict means only that no unsupported claim was identified
  in this comparison. It does not prove that the claim is true.

Return JSON with exactly these fields:
{{
  "supported": true,
  "issues": [],
  "summary": "Brief explanation of the review"
}}

Set supported to false if one or more substantive factual claims are
unsupported. In that case, include concise, actionable issues identifying
the relevant claims.
""".strip()

    review = _gemini_json(prompt, max_output_tokens=700)

    # Do not interpret a missing or malformed review as a successful
    # Gemini review. Retain the deterministic result and disclose the gap.
    if (
        not isinstance(review, dict)
        or not isinstance(review.get("supported"), bool)
        or not isinstance(review.get("issues"), list)
        or not isinstance(review.get("summary"), str)
    ):
        return {
            **baseline,
            "critique": (
                f"{baseline.get('critique', '')} "
                "Gemini evidence review unavailable; factual accuracy "
                "has not been independently verified."
            ).strip(),
        }

    issues = _clean_str_list(review["issues"], 8)
    summary = " ".join(review["summary"].split())

    if not review["supported"] or issues:
        feedback = (
            "Gemini evidence review flagged potentially unsupported "
            "claims. Revise or remove them using the supplied research: "
            + "; ".join(issues)
        ) if issues else (
            "Gemini evidence review rejected the script but returned "
            "no actionable issues. Review the script against the "
            "supplied research summaries."
        )

        # Signal the workflow that this rejection may need more evidence.
        # Preserve any categories and gaps reported by the deterministic critic.
        existing_categories = baseline.get("critic_categories", [])
        existing_gaps = baseline.get("research_gaps", [])

        return {
            "approved": False,
            "critique": (
                f"{baseline.get('critique', '')} {feedback}"
            ).strip(),
            "critic_categories": list(dict.fromkeys([
                *existing_categories,
                "unsupported_claims",
            ])),
            "research_gaps": list(dict.fromkeys([
                *existing_gaps,
                *issues,
            ])) or [
                "Gemini flagged potentially unsupported claims, "
                "but did not identify specific claims to investigate."
            ],
        }

    return {
        **baseline,
        "critique": (
            f"{baseline.get('critique', '')} "
            f"Gemini evidence review: {summary or 'No unsupported claims identified in the supplied summaries.'} "
            "This is not independent factual verification."
        ).strip(),
    }


def revise_script_node(state: VideoState, writer=None) -> dict:
    """Rewrite a rejected script, giving the writer the critic's feedback."""
    if state["revision_count"] >= 2:
        return {
            "critique": "Revision limit reached.",
            "approved": False,
            "revision_count": state["revision_count"],
        }

    if not state.get("research_sources"):
        return {
            "critique": "Cannot revise without research sources.",
            "approved": False,
        }

    # Use the workflow's selected writer; retain deterministic default
    # behavior for direct calls and existing tests.
    selected_writer = writer or scriptwriter_node
    revised = selected_writer(state)

    result = {
        "script": revised["script"],
        "revision_count": state["revision_count"] + 1,
    }

    if "script_sources" in revised:
        result["script_sources"] = revised["script_sources"]

    return result
