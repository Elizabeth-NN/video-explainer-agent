def _normalize_words(text: str) -> list[str]:
    """Normalize text into simple searchable word forms."""
    words = re.findall(r"[a-z0-9]+", text.lower())
    normalized = []

    for word in words:
        # Normalize irregular and common plurals before the generic rule.
        if word.endswith("indexes"):
            word = word[:-2]
        elif word.endswith("indices"):
            word = "index"
        elif word.endswith("ies") and len(word) > 4:
            word = word[:-3] + "y"
        elif len(word) > 4 and word.endswith("s"):
            word = word[:-1]

        if word not in STOP_WORDS:
            normalized.append(word)
    return normalized


def _physics_source_is_relevant(
    topic: str,
    title: str,
    summary: str,
) -> bool:
    """Conservatively match sources to the physics concepts requested."""
    topic_lower = " ".join(topic.casefold().split())
    title_lower = " ".join(title.casefold().split())
    summary_lower = summary.casefold()
    combined = f"{title_lower} {summary_lower}"

    requested = {
        "newton": "newton" in topic_lower,
        "kinematics": "kinematics" in topic_lower,
        "free_fall": "free fall" in topic_lower,
        "projectile": "projectile motion" in topic_lower,
        "potential_energy": "potential energy" in topic_lower,
    }

    if not any(requested.values()):
        return False

    # Reject obvious namesakes and robotics-specific kinematics pages.
    if any(
        marker in title_lower
        for marker in ("disambiguation", "(film)", "(movie)")
    ):
        return False

    if "robot" in combined:
        return False

    matches = []

    if requested["newton"]:
        law_title = (
            "newton's second law" in title_lower
            or "newton's laws of motion" in title_lower
        )
        evidence = all(
            term in summary_lower
            for term in ("force", "mass", "acceleration")
        )
        matches.append(law_title and evidence)

    if requested["kinematics"]:
        title_matches = "kinematics" in title_lower
        evidence_count = sum(
            term in summary_lower
            for term in (
                "motion",
                "position",
                "displacement",
                "velocity",
                "acceleration",
            )
        )
        matches.append(title_matches and evidence_count >= 2)

    if requested["free_fall"]:
        title_matches = (
            "free fall" in title_lower
            or "falling object" in title_lower
        )
        evidence = (
            "gravity" in summary_lower
            and (
                "falling" in summary_lower
                or "free fall" in summary_lower
            )
        )
        matches.append(title_matches and evidence)

    if requested["projectile"]:
        title_matches = "projectile motion" in title_lower
        evidence = (
            "projectile" in summary_lower
            and any(
                term in summary_lower
                for term in (
                    "trajectory",
                    "gravity",
                    "horizontal",
                    "vertical",
                    "launch angle",
                )
            )
        )
        matches.append(title_matches and evidence)

    if requested["potential_energy"]:
        title_matches = (
            "potential energy" in title_lower
            or "gravitational energy" in title_lower
        )
        evidence_count = sum(
            term in summary_lower
            for term in (
                "gravity",
                "gravitational",
                "height",
                "mass",
                "position",
            )
        )
        matches.append(title_matches and evidence_count >= 2)

    return any(matches)


def is_relevant_source(topic: str, title: str, summary: str) -> bool:
    """Conservative keyword fallback for research-source relevance.

    Gemini handles semantic ranking when available. This fallback rejects
    obvious namesakes and permits a few well-established supporting concepts.
    """
    normalized_topic = " ".join(topic.lower().split())
    title_lower = " ".join(title.lower().split())
    summary_lower = summary.lower()
    combined = f"{title_lower} {summary_lower}"

    topic_words = set(_normalize_words(topic))
    title_words = set(_normalize_words(title))
    content_words = set(_normalize_words(combined))

    if not topic_words or not title_words:
        return False

    # For physics lessons, use concept-specific matching instead of the
    # generic title-overlap rules below.
    physics_markers = (
        "newton",
        "kinematics",
        "free fall",
        "projectile motion",
        "potential energy",
    )
    if any(marker in normalized_topic for marker in physics_markers):
        return _physics_source_is_relevant(topic, title, summary)

    # Reject obvious meanings that conflict with the requested topic.
    if "vaccine" in topic_words and any(
        marker in combined
        for marker in (
            "indie rock band",
            "rock band",
            "musical group",
            "music band",
        )
    ):
        return False

    if "inflation" in topic_words and any(
        marker in combined
        for marker in (
            "cosmology",
            "cosmic inflation",
            "early universe",
            "expansion of the universe",
        )
    ):
        return False

    if (
        "solar" in topic_words
        and ("energy" in topic_words or "power" in topic_words)
        and (
            "solar corona" in title_lower
            or "outer atmosphere" in summary_lower
        )
    ):
        return False

    if "earthquake" in topic_words and any(
        marker in title_lower
        for marker in ("(film)", "(movie)", "film)")
    ):
        return False

    if (
        "database" in topic_words
        and "index" in topic_words
        and any(
            marker in title_lower
            for marker in ("(mathematics)", "(economics)")
        )
    ):
        return False

    # Exact title matches are strong evidence, except for the disambiguations
    # rejected above.
    if title_lower in normalized_topic:
        return True

    if title_words.issubset(topic_words) and len(title_words) >= 2:
        return True

    # Accept a related concept when the summary explicitly connects it to
    # the requested domain. These are supporting concepts, not query plans.
    supporting_concepts = (
        (
            {"solar", "energy"} <= topic_words
            and "solar" in title_words
            and any(
                term in content_words
                for term in ("photovoltaic", "sunlight", "electricity")
            )
        ),
        (
            "earthquake" in topic_words
            and any(term in title_words for term in ("fault", "tectonic", "seismic"))
            and any(
                term in content_words
                for term in ("earthquake", "fault", "tectonic", "seismic")
            )
        ),
        (
            {"database", "index"} <= topic_words
            and any(term in content_words for term in ("database", "query", "lookup"))
            and any(term in content_words for term in ("index", "indexed", "tree"))
        ),
        (
            "vaccine" in topic_words
            and any(
                term in title_words
                for term in ("immune", "system", "immunity", "antibody")
            )
            and any(
                term in content_words
                for term in (
                    "vaccine",
                    "pathogen",
                    "immune",
                    "immunity",
                    "antibody",
                )
            )
        ),
    )

    if any(supporting_concepts):
        return True

    # Multi-concept physics lessons may rely on separate articles.
    # Require a concept-specific title and supporting evidence in the summary.
    physics_topic = " ".join(topic.lower().split())

    physics_evidence = {
        "newton": (
            ("newton", "law of motion", "net force"),
            ("force", "mass", "acceleration"),
        ),
        "kinematics": (
            ("kinematics",),
            ("velocity", "displacement", "acceleration", "position"),
        ),
        "free fall": (
            ("free fall", "falling object"),
            ("gravity", "gravitational acceleration", "falling"),
        ),
        "projectile": (
            ("projectile",),
            ("trajectory", "launch angle", "parabolic", "projectile"),
        ),
        "potential energy": (
            ("potential energy", "gravitational potential"),
            ("height", "mass", "gravity", "energy"),
        ),
    }

    for concept, (title_markers, evidence_markers) in physics_evidence.items():
        if concept not in physics_topic:
            continue

        title_matches = any(
            marker in title_lower for marker in title_markers
        )
        # The title identifies the concept; the summary must supply
        # evidence connecting the article to that concept.
        evidence_matches = sum(
            marker in summary_lower for marker in evidence_markers
        )

        if title_matches and evidence_matches >= 1:
            return True

    matched_words = topic_words & content_words
    required_matches = max(1, (len(topic_words) * 2 + 2) // 3)

    return len(matched_words) >= required_matches

def gemini_relevance_filter(
    topic: str,
    candidates: list[dict],
    key_questions: list[str] | None = None,
) -> tuple[list[dict], set[int]] | None:
    """Judge candidate relevance and key-question coverage in one request.

    Return (relevant candidates, indices of key questions that the
    relevant candidates help answer), or None if Gemini is unavailable
    or its response cannot be processed.
    """
    if not candidates:
            return None

    key_questions = key_questions or []

    candidate_data = [
        {
            "index": index,
            "title": source["title"],
            "summary": source["summary"][:1200],
        }
        for index, source in enumerate(candidates)
    ]
    question_data = [
        {"index": index, "question": question}
        for index, question in enumerate(key_questions)
    ]

    prompt = (
        "Decide which candidate Wikipedia articles are directly relevant "
        "to the user's research topic. Relevance means the article "
        "substantively helps explain or answer the topic, not merely that "
        "it shares a word or is a different subject with the same name. "
        "Reject tangential articles and namesakes. Prefer articles that "
        "use different terminology but explain the same subject. Use only "
        "the supplied titles and summaries.\n\n"
        "Return JSON with two fields:\n"
        "- relevant_indices: zero-based indices of relevant articles "
        "(an empty list if none are relevant).\n"
        "- covered_question_indices: zero-based indices of the key "
        "questions that the relevant articles' summaries help answer "
        "(an empty list if there are no key questions).\n\n"
        f"Topic: {topic}\n\n"
        f"Key questions: {json.dumps(question_data, ensure_ascii=False)}\n\n"
        f"Candidates: {json.dumps(candidate_data, ensure_ascii=False)}"
    )

    data = _gemini_json(prompt, max_output_tokens=400)
    if data is None:
        return None

    indices = data.get("relevant_indices")
    if not isinstance(indices, list):
        return None

    selected = []
    seen = set()

    for index in indices:
        if (
            isinstance(index, int)
            and not isinstance(index, bool)
            and 0 <= index < len(candidates)
            and index not in seen
        ):
            selected.append(candidates[index])
            seen.add(index)

    covered = set()
    raw_covered = data.get("covered_question_indices")

    if isinstance(raw_covered, list) and selected:
        for index in raw_covered:
            if (
                isinstance(index, int)
                and not isinstance(index, bool)
                and 0 <= index < len(key_questions)
            ):
                covered.add(index)

    return selected, covered


